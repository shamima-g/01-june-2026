# API Configuration
# Copy this file to .env.local and update with your values.
# NEVER commit .env.local — it is gitignored.

# --- Transactions API (port 10005, path prefix /transactions-api) ---
# Source of truth: backend-api/README.md. Spec declared localhost:4423 which is stale.
NEXT_PUBLIC_API_BASE_URL=http://localhost:10005/transactions-api

# --- Authentication API (port 10010) ---
# Source of truth: backend-api/README.md. Spec declared localhost:4423 which is stale.
NEXT_PUBLIC_AUTH_API_BASE_URL=http://localhost:10010

# --- Test credentials (captured by api-connectivity-agent during INTAKE) ---
# Used by the smoke test (generated-docs/context/api-smoke-test.sh) and integration tests.
# Auth model: session cookie — POST /v1/auth/login with {"Username","Password"} -> Set-Cookie: session=...
# The session cookie is HttpOnly; SameSite=Strict. The frontend MUST proxy both backends
# via Next.js route handlers to stay same-origin — direct cross-origin fetch will fail.
TEST_USERNAME=
TEST_PASSWORD=

# --- Notes ---
# NEXT_PUBLIC_API_AUTH_HEADER / NEXT_PUBLIC_API_AUTH_VALUE_PREFIX / NEXT_PUBLIC_API_TOKEN
# are NOT used for this project. Auth is handled via session cookie, not a bearer/API-key header.
# The API client should attach the cookie automatically when requests are proxied same-origin.
